{
  "openapi": "3.1.0",
  "info": {
    "title": "WMS inventory backend",
    "version": "0.5.0",
    "description": "Inventory API backed by PostgreSQL kernel commands. OIDC JWT access tokens identify users; database grants authorize warehouses and owners. PostgreSQL is the sole business guard evaluator; the host validates module configuration. Trusted compiled modules and bounded declarative policies are supported. Product licensing is not selected yet."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local default; production ingress must use HTTPS."
    }
  ],
  "security": [
    {
      "BearerAccessToken": []
    }
  ],
  "tags": [
    {
      "name": "Inventory",
      "description": "Scoped reads and transactional mutations."
    },
    {
      "name": "Health",
      "description": "Liveness and database readiness."
    }
  ],

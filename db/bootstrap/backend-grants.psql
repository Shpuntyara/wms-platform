\set ON_ERROR_STOP on
-- Apply after migration 0004, in addition to grants.psql.
GRANT SELECT ON contracts_v1.actor_grants, contracts_v1.document_lines,
  contracts_v1.reservations, contracts_v1.movements, contracts_v1.operations,
  contracts_v1.active_modules, contracts_v1.module_migrations TO :"runtime_role";
GRANT EXECUTE ON FUNCTION inventory.prepare_reservation(uuid,uuid,uuid,bigint,uuid,numeric,timestamptz) TO :"runtime_role";
GRANT EXECUTE ON FUNCTION inventory.prepare_release(uuid,uuid,uuid,bigint,numeric,text) TO :"runtime_role";

  "query": "WITH document_page AS MATERIALIZED (\nSELECT candidates.id FROM (SELECT DISTINCT unnest($3::text[])::uuid AS owner_id) AS permitted_owner\nCROSS JOIN LATERAL (SELECT id FROM contracts_v1.documents\nWHERE organization_id=$1::text::uuid AND warehouse_id=$2::text::uuid\nAND (owner_id,id)>(permitted_owner.owner_id,$4::text::uuid) AND owner_id<=permitted_owner.owner_id ORDER BY owner_id,id LIMIT $5) AS candidates\nORDER BY candidates.id LIMIT $5)\nSELECT to_jsonb(document_details) FROM document_page\nJOIN contracts_v1.document_details USING (id) ORDER BY document_details.id",

# One client owns this on-premise WMS/database/server. Never use the installation owner.
WMS_DATABASE_URL=postgres://wms_service@127.0.0.1:5432/wms?sslmode=disable
# Install the profile and dedicated roles first. See docs/security-hardened-profile.md.
# An empty value also selects onprem-v1. Explicit legacy retains the trusted SQL contract.
WMS_DATABASE_PROFILE=onprem-v1
# Use a distinct worker login for the same client installation (all its warehouses).
WMS_WORKER_DATABASE_URL=
# Independent base64 32-byte request signing key from your secret configuration.
WMS_REQUEST_CONTEXT_KEY=
WMS_OIDC_ISSUER=https://identity.example.invalid/realms/company
WMS_OIDC_AUDIENCE=wms-api
WMS_HTTP_ADDR=127.0.0.1:8080
WMS_DB_MAX_CONNS=20
# Optional extra requirements; installed database requirements are always enforced.
WMS_REQUIRED_MODULES=

# Mandatory fixed broker ingress; receiver must deduplicate X-WMS-Event-ID.
WMS_OUTBOX_URL=https://events.example.invalid/wms
# Supply base64 encoding of at least 32 random bytes through your secret manager.
WMS_OUTBOX_HMAC_KEY=
# Permit private unicast broker addresses for on-premises installations.
# Loopback, link-local and metadata endpoints remain forbidden.
WMS_OUTBOX_ALLOW_PRIVATE=false

# Concurrent outbox senders per process (1..64). Slots refill independently.
WMS_OUTBOX_CONCURRENCY=16
# Dedicated operations listener: must be a literal loopback IP.
# GET /metrics and GET /health/background; never expose this port publicly.
WMS_MONITOR_ADDR=127.0.0.1:9091
# Background DB pool is separate: 4 connections in addition to WMS_DB_MAX_CONNS.

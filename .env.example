# Provision a dedicated login inheriting the runtime role; never use the owner.
WMS_DATABASE_URL=postgres://wms_service@127.0.0.1:5432/wms?sslmode=disable
WMS_OIDC_ISSUER=https://identity.example.invalid/realms/company
WMS_OIDC_AUDIENCE=wms-api
WMS_HTTP_ADDR=127.0.0.1:8080
WMS_DB_MAX_CONNS=20
# Optional extra requirements; installed database requirements are always enforced.
WMS_REQUIRED_MODULES=

# Mandatory fixed broker ingress; receiver must deduplicate X-WMS-Event-ID.
WMS_OUTBOX_URL=https://events.example.invalid/wms
# Supply base64 encoding of at least 32 random bytes through your secret manager.
WMS_OUTBOX_HMAC_KEY=
# Permit private unicast broker addresses for on-premises installations.
# Loopback, link-local and metadata endpoints remain forbidden.
WMS_OUTBOX_ALLOW_PRIVATE=false
